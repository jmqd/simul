from typing import Any, Dict, List, Optional, Sequence, Tuple, Union

class TrialRng:
    def __init__(self, seed: int) -> None: ...
    def next_u64(self) -> int: ...
    def uniform_f64(self) -> float: ...
    def clone_rng(self) -> TrialRng: ...

class Message:
    @property
    def queued_time(self) -> int: ...
    @property
    def source(self) -> Optional[int]: ...
    @property
    def destination(self) -> Optional[int]: ...
    @property
    def payload(self) -> Any: ...

class AgentContext:
    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def time(self) -> int: ...
    @property
    def queue_len(self) -> int: ...
    def agent_id(self, name: str) -> Optional[int]: ...
    def uniform_f64(self) -> float: ...
    def next_u64(self) -> int: ...
    def send(self, target: str, payload: Any) -> None: ...
    def send_to(self, target_id: int, payload: Any) -> None: ...
    def send_after(self, delay: int, target_id: int, payload: Any) -> int: ...
    def cancel_timer(self, timer_handle: int) -> None: ...
    def sleep_for(self, ticks: int) -> None: ...
    def mark_in_progress(self) -> None: ...
    def yield_control(self, tag: str) -> None: ...
    def send_halt_interrupt(self, reason: str) -> None: ...

class RunOutcome:
    @property
    def kind(self) -> str: ...
    @property
    def agent_id(self) -> Optional[int]: ...
    @property
    def tag(self) -> Optional[str]: ...
    @property
    def reason(self) -> Optional[str]: ...

class Simulation:
    def __init__(
        self,
        halt_time: Optional[int] = None,
        seed: int = 0,
        trace: bool = False,
        strict_routing: bool = False,
    ) -> None: ...
    def add_periodic_producer(
        self, name: str, period: int, target: str, asleep_until: Optional[int] = None
    ) -> None: ...
    def add_periodic_consumer(
        self, name: str, period: int, asleep_until: Optional[int] = None
    ) -> None: ...
    def add_geometric_producer(
        self, name: str, mean_gap: float, target: str, asleep_until: Optional[int] = None
    ) -> None: ...
    def add_geometric_consumer(
        self, name: str, mean_gap: float, asleep_until: Optional[int] = None
    ) -> None: ...
    def add_agent(
        self,
        name: str,
        agent: Any,
        proactive: bool = False,
        drain_all: bool = False,
        asleep_until: Optional[int] = None,
    ) -> None: ...
    def run(self) -> RunOutcome: ...
    def run_until(self, time: int) -> RunOutcome: ...
    def run_until_yield(self, max_time: Optional[int] = None) -> RunOutcome: ...
    def clone_snapshot(self) -> Simulation: ...
    def reseed(self, seed: int) -> None: ...
    def push_message(self, agent_name: str, payload: Any) -> None: ...
    def agent(self, name: str) -> Any: ...
    @property
    def time(self) -> int: ...
    @property
    def mode(self) -> str: ...
    @property
    def halt_reason(self) -> Optional[str]: ...
    @property
    def yield_tag(self) -> Optional[str]: ...
    @property
    def unknown_destination_count(self) -> int: ...
    def consumed_counts(self) -> Dict[str, int]: ...
    def produced_counts(self) -> Dict[str, int]: ...
    def queue_lengths(self) -> Dict[str, int]: ...
    def avg_wait_times(self) -> Dict[str, float]: ...
    def enable_trace(self) -> None: ...
    def disable_trace(self) -> None: ...
    def trace_jsonl(self) -> Optional[str]: ...
    def trace_perfetto_json(self) -> Optional[str]: ...
    def forensic_trace_perfetto(self, start: int, end: Optional[int] = None) -> str: ...

class ScalarSummary:
    @staticmethod
    def from_values(values: Sequence[float]) -> ScalarSummary: ...
    @property
    def count(self) -> int: ...
    @property
    def mean(self) -> float: ...
    @property
    def sample_variance(self) -> Optional[float]: ...
    @property
    def standard_error(self) -> Optional[float]: ...
    @property
    def min(self) -> float: ...
    @property
    def max(self) -> float: ...
    def ci_95(self) -> Optional[Tuple[float, float]]: ...

class BernoulliSummary:
    @staticmethod
    def from_results(
        results: Sequence[bool], wilson_z: Optional[float] = None
    ) -> BernoulliSummary: ...
    @property
    def attempts(self) -> int: ...
    @property
    def successes(self) -> int: ...
    @property
    def rate(self) -> float: ...
    @property
    def wilson_lower(self) -> float: ...
    @property
    def wilson_upper(self) -> float: ...

class QuantileSummary:
    @staticmethod
    def from_values(values: Sequence[float]) -> QuantileSummary: ...
    @property
    def count(self) -> int: ...
    @property
    def mean(self) -> float: ...
    @property
    def min(self) -> float: ...
    @property
    def max(self) -> float: ...
    def median(self) -> float: ...
    def p90(self) -> float: ...
    def p95(self) -> float: ...
    def p99(self) -> float: ...
    def p999(self) -> float: ...
    def quantile(self, p: float) -> float: ...
    def upper_cvar(self, alpha: float) -> float: ...
    def lower_cvar(self, tail: float) -> float: ...

class PairedScalarSummary:
    @staticmethod
    def from_pairs(
        baseline: Sequence[float], challenger: Sequence[float]
    ) -> PairedScalarSummary: ...
    @property
    def usable_pairs(self) -> int: ...
    @property
    def challenger_wins(self) -> int: ...
    @property
    def baseline_wins(self) -> int: ...
    @property
    def ties(self) -> int: ...
    @property
    def mean_diff(self) -> float: ...
    @property
    def standard_error(self) -> Optional[float]: ...
    def ci_95(self) -> Optional[Tuple[float, float]]: ...
    def variance_reduction_ratio(self) -> Optional[float]: ...

class MixedDimension:
    @staticmethod
    def continuous(lower: float, upper: float) -> MixedDimension: ...
    @staticmethod
    def circular(lower: float, upper: float) -> MixedDimension: ...
    @staticmethod
    def categorical(categories: int) -> MixedDimension: ...
    @staticmethod
    def integer(min: int, max: int) -> MixedDimension: ...

class MixedCrossEntropyOptimizer:
    def __init__(
        self,
        dimensions: Sequence[MixedDimension],
        elite_fraction: float = 0.15,
        learning_rate: float = 0.7,
    ) -> None: ...
    def ask(self, rng: TrialRng) -> List[Union[float, int]]: ...
    def ask_batch(self, rng: TrialRng, count: int) -> List[List[Union[float, int]]]: ...
    def tell(
        self, points: Sequence[Sequence[Union[float, int]]], scores: Sequence[float]
    ) -> Optional[Tuple[int, float]]: ...
    @property
    def generation(self) -> int: ...
    def best(self) -> Optional[Tuple[List[Union[float, int]], float]]: ...
    def categorical_probabilities(self, dimension: int) -> Optional[List[float]]: ...
    def dimension_mean(self, dimension: int) -> Optional[float]: ...

class ParetoArchive:
    def __init__(self, directions: Sequence[str]) -> None: ...
    def insert(self, candidate_id: int, payload: Any, objectives: Sequence[float]) -> bool: ...
    def __len__(self) -> int: ...
    def frontier(self) -> List[Dict[str, Any]]: ...
    def crowding_distances(self) -> List[float]: ...
    def hypervolume_2d(self, ref_x: float, ref_y: float) -> float: ...

def sample_bounded(
    seed: int, budget: int, bounds: Sequence[Tuple[float, float]]
) -> List[List[float]]: ...
def sample_latin_hypercube(
    seed: int, samples: int, bounds: Sequence[Tuple[float, float]]
) -> List[List[float]]: ...
def sample_sobol(
    samples: int, bounds: Sequence[Tuple[float, float]]
) -> List[List[float]]: ...
def sample_sobol_scrambled(
    seed: int, samples: int, bounds: Sequence[Tuple[float, float]]
) -> List[List[float]]: ...
